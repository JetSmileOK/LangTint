# PREPARATION ONLY: do not copy this into .github/workflows until SignPath Foundation
# has approved the project and the signing environment/variables are configured.
name: SignPath LangTint runtime candidate
on:
  workflow_dispatch:
permissions:
  contents: read
  actions: read
jobs:
  sign:
    if: github.ref == 'refs/heads/main'
    runs-on: windows-2022
    environment: signing
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - name: Require approved configuration
        env:
          SIGNPATH_READY: ${{ vars.SIGNPATH_READY }}
          ORG: ${{ vars.SIGNPATH_ORGANIZATION_ID }}
          PROJECT: ${{ vars.SIGNPATH_PROJECT_SLUG }}
          POLICY: ${{ vars.SIGNPATH_SIGNING_POLICY_SLUG }}
          CONFIG: ${{ vars.SIGNPATH_ARTIFACT_CONFIGURATION_SLUG }}
        shell: pwsh
        run: |
          if ($env:SIGNPATH_READY -ne 'true') { throw 'Production signing not approved' }
          foreach ($name in @('ORG','PROJECT','POLICY','CONFIG')) {
            if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name))) { throw "Missing $name" }
          }
      - uses: actions/setup-go@44694675825211faa026b3c33043df3e48a5fa00 # v6.0.0
        with:
          go-version: '1.27.1'
          cache: false
      - name: Build reviewed runtime
        shell: pwsh
        run: |
          python tools/release.py verify-source
          python tools/release.py verify-installer
          python -m unittest discover -s tools -p "test_*.py" -v
          Push-Location source
          go test -count=100 ./...
          go vet ./...
          New-Item -ItemType Directory -Force ..\build | Out-Null
          go build -buildvcs=false -trimpath -ldflags="-H=windowsgui -s -w" -o ..\build\LangTint.exe .
          Pop-Location
      - name: Upload exact runtime signing input
        id: unsigned
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: unsigned-signing-input
          path: build/LangTint.exe
          if-no-files-found: error
      - name: Submit to SignPath; manual approval remains required
        uses: signpath/github-action-submit-signing-request@c92b958760219087e01f8d67a1669ed57afe2627 # v2
        with:
          api-token: ${{ secrets.SIGNPATH_API_TOKEN }}
          organization-id: ${{ vars.SIGNPATH_ORGANIZATION_ID }}
          project-slug: ${{ vars.SIGNPATH_PROJECT_SLUG }}
          signing-policy-slug: ${{ vars.SIGNPATH_SIGNING_POLICY_SLUG }}
          artifact-configuration-slug: ${{ vars.SIGNPATH_ARTIFACT_CONFIGURATION_SLUG }}
          github-artifact-id: ${{ steps.unsigned.outputs.artifact-id }}
          wait-for-completion: true
          wait-for-completion-timeout-in-seconds: 3600
          output-artifact-directory: signed
          parameters: |
            version: "1.7.1"
      - name: Stop here until installer dual-sign flow is reviewed
        shell: pwsh
        run: |
          Write-Host 'Runtime signing output received. Do not publish yet.'
          Write-Host 'The production flow must compile Setup with the signed LangTint.exe and then sign/verify LangTint-Setup-x64.exe separately.'
